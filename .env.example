# Root .env — secrets and local overrides only.
# Per-module settings live in configs/*.env (loaded first, then this file overrides).
#
# Copy:  cp .env.example .env
# Edit configs/*.env for risk, structure, backtest, strategy, etc.

# ── Secrets (keep out of git) ─────────────────────────────────────
MEXC_API_KEY=your_mexc_api_key
MEXC_API_SECRET=your_mexc_api_secret
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Optional local overrides (uncomment to override configs/*.env) ─
# TIMEFRAME=5m
# STRUCTURE_TIMEFRAME=1h
# STRUCTURE_LOG_MODE=events
# MIN_SIGNAL_SCORE=85
# BACKTEST_INITIAL_CAPITAL=250
