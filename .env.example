MEXC_API_KEY=your_mexc_api_key
MEXC_API_SECRET=your_mexc_api_secret
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
DB_PATH=storage/trade_history.db
LOG_LEVEL=INFO

# ── Risk limits ───────────────────────────────────────────────────
MAX_CONCURRENT_TRADES=1
MAX_DAILY_LOSS=500
RISK_PER_TRADE=0.02
COOLDOWN_SECONDS=60
MAX_DRAWDOWN_PERCENT=20
CONSECUTIVE_LOSS_LIMIT=3
MAX_RISK_PER_SYMBOL=0.1
MAX_LEVERAGE=5

# ── Global TP/SL (RiskManager – applies to all strategies) ───────
STOP_LOSS_MODE=atr
STOP_LOSS_ATR_MULTIPLIER=2.5
STOP_LOSS_PCT=0.015
# Long-term runner TP (e.g. 100R); partial profit locks gains at +1R
TAKE_PROFIT_RR=100
MIN_SL_PCT=0.005
MAX_SL_PCT=0.018
MIN_SL_HOLD_BARS=3
MOVE_SL_TO_BREAKEVEN_AT_1R=true
USE_TREND_EXIT=true
# Trend exit only after +1R (protects runner until profit secured)
TREND_EXIT_AFTER_1R_ONLY=true
# At +1R: take partial profit once, move SL to breakeven, let runner ride to TP
PARTIAL_PROFIT_ENABLED=true
PARTIAL_PROFIT_PCT=30
PARTIAL_PROFIT_AT_R=1.0
# Stepped trailing SL for runner: at nR lock SL at (n-2)R → 1R→BE, 3R→+1R, 4R→+2R, …
STEPPED_TRAIL_ENABLED=true
STEPPED_TRAIL_LOCK_OFFSET=2

# ── Compounding (position size scales with portfolio equity) ───────
COMPOUNDING_ENABLED=true
POSITION_SIZE_PCT=1.0

# ── Martingale (increase risk after consecutive losses) ───────────
MARTINGALE_ENABLED=false
MARTINGALE_MULTIPLIER=2.0
MARTINGALE_MAX_STEPS=3

# ── Market / backtest ─────────────────────────────────────────────
# Strategy TF: entries, channel breakouts, retest (typical 5m–15m)
TIMEFRAME=15m
# Structure TF: HH/HL bias filter before entry (typical 1h–4h when strategy is 5m–15m)
STRUCTURE_TIMEFRAME=1h
STRUCTURE_MTF_ENABLED=true
STRUCTURE_PIVOT_LEN=5
# BOS/CHoCH structure breaks on swing levels (SMC-style bias filter)
STRUCTURE_USE_BOS_CHOCH=true
STRUCTURE_BREAK_CONFIRM_CLOSE=true
# Block LTF entry when HTF CHoCH is against trade direction
STRUCTURE_BLOCK_ENTRY_ON_COUNTER_CHOCH=true
# Close open positions on counter CHoCH (structure TF)
STRUCTURE_CHOCH_EXIT_ENABLED=false
DATA_DIR=data/candles
# Re-sync local Parquet before backtest if last candle is older than N days
DATASET_SYNC_ON_BACKTEST=true
DATASET_MAX_STALE_DAYS=1
BACKTEST_INITIAL_CAPITAL=250
BACKTEST_HALT_ON_DRAWDOWN=false
PORTFOLIO_BACKTEST=true
# Minimum signal score (0–100). Values below 70 also relax require_confirmed_structure.
MIN_SIGNAL_SCORE=70
DEFAULT_STRATEGY=trendline_breakout

# Per-symbol strategy overrides (JSON). Merged over built-in alt defaults.
# BTC uses class defaults when not listed here.
# SYMBOL_STRATEGY_PARAMS={"SOLUSDT":{"vol_multiplier":3.5}}

# Strategy entries (optional JSON override):
# STRATEGIES='[{"name":"trendline_breakout","enabled":true,"symbols":["BTCUSDT","ETHUSDT"],"params":{},"symbol_params":{"ETHUSDT":{"vol_multiplier":4.0}}}]'
