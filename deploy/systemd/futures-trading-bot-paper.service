[Unit]
Description=Futures Trading Bot — paper trade (simulated orders, live OHLCV)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@INSTALL_DIR@
Environment=PYTHONUNBUFFERED=1
# Override strategy/symbols in ExecStart or via configs/strategy.env
ExecStart=@INSTALL_DIR@/venv/bin/python main.py -m papertrade -s trendline_breakout
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
