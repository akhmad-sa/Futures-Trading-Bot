"""
Slippage model based on a :class:`SimulationConfig`.

Applies a fractional slippage to entry and exit prices.
"""

from simulation.config import SimulationConfig


class SlippageModel:
    """Encapsulates slippage logic for a backtest."""

    def __init__(self, config: SimulationConfig) -> None:
        self._slippage = config.slippage

    def entry_price(self, side: str, price: float) -> float:
        """
        Return the executed entry price after slippage.

        Parameters
        ----------
        side : str
            ``'long'`` or ``'short'``.
        price : float
            Reference price (e.g. candle close).

        Returns
        -------
        float
            Price after applying slippage.
        """
        if side == "long":
            return price * (1 + self._slippage)
        else:
            return price * (1 - self._slippage)

    def exit_price(self, side: str, price: float) -> float:
        """
        Return the executed exit price after slippage.

        Parameters
        ----------
        side : str
            The current position side.
        price : float
            Reference price.

        Returns
        -------
        float
            Price after applying slippage.
        """
        if side == "long":
            return price * (1 - self._slippage)
        else:
            return price * (1 + self._slippage)
