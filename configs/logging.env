# Logging — file verbose, terminal quiet (see utils/console.py)
LOG_LEVEL=INFO

# Structure diagnostics → logs/trading.log only (never stdout)
# off     = disabled
# events  = state changes, CHoCH blocks, near-miss scores (recommended)
# full    = every bar scan (large files)
STRUCTURE_LOG_MODE=off
STRUCTURE_LOG_NEAR_MISS_MIN=80
# Legacy alias — prefer STRUCTURE_LOG_MODE=full
STRUCTURE_LOG_VERBOSE=false
