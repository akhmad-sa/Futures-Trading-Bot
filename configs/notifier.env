# Telegram control bot + trading daemon monitoring
TRADING_BOT_SERVICE=futures-trading-bot-paper
HEARTBEAT_PATH=storage/heartbeat.json
TELEGRAM_CONTROL_POLL_SECONDS=30
TELEGRAM_TRADE_STATUS_LIMIT=10
# Optional: restrict who can run bot commands (comma-separated Telegram user IDs)
# Example: TELEGRAM_ALLOWED_USER_IDS=1921646439
# Leave empty to allow anyone in TELEGRAM_CHAT_ID
TELEGRAM_ALLOWED_USER_IDS=
